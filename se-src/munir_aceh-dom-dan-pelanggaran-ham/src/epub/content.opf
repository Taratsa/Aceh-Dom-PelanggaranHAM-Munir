		<dc:title id="title">Aceh, DOM dan Pelanggaran HAM</dc:title>
		<meta property="file-as" refines="#title">Aceh, DOM dan Pelanggaran HAM</meta>
		<dc:subject id="subject-1">Human rights--Indonesia</dc:subject>
